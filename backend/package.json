{
  "name": "bublix-shipping-backend",
  "version": "1.0.0",
  "description": "Bublix Shipping Global Logistics Platform – Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore node_modules server.js",
    "seed": "node database/seed.js",
    "db:sync": "node -e \"require('./modules/index').sequelize.sync({force:false}).then(()=>process.exit(0))\"",
    "db:drop": "node -e \"require('./modules/index').sequelize.drop().then(()=>process.exit(0))\"",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed:all": "sequelize-cli db:seed:all",
    "test": "jest --forceExit"
  },
  "keywords": [
    "logistics",
    "shipping",
    "express",
    "sequelize"
  ],
  "author": "Bublix Shipping",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "uuid": "^9.0.1"
  }
}
